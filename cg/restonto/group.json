{
 "id": 78037,
 "name": "Restaurant Ontology Community Group",
 "is_closed": true,
 "creation-date": "2015-04-28",
 "description": "The mission of this group is to create a new ontology to describe restaurants, and reservations to those restaurants. The ontology will support queries such as:\r\n<ul>\r\n<li>Find an Asian restaurant for a business meal, near my job place.</li>\r\n<li>Schedule a meal with friends, and add it to my calendar.</li>\r\n<li>Find a restaurant with good reviews of people I trust.</li>\r\n<li>Find a cheap restaurant near a cinema where I can see the last movie of my favorite director (yes, we need an ontology for cinemas too!)</li>\r\n</ul>",
 "shortname": "restonto",
